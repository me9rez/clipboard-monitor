<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Publish 参数（单文件 / 裁剪 / AOT）仅在 dotnet publish 时通过命令行传入，
         避免 build/test 阶段 restore 沉重的 runtime packs。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除同目录下的测试项目代码，防止 SDK 默认 glob 将其编译进主项目 -->
    <Compile Remove="ClipboardMonitor.Tests\**\*.cs" />
  </ItemGroup>
</Project>
